# Solana Time Machine Environment Configuration
# Copy this file to .env.local and fill in your values

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://solana-time-machine.vercel.app

# Solana Configuration
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Wallet Payment Configuration (for real payments - optional for demo)
# Get from https://faucet.solana.com/
NEXT_PUBLIC_PAYER_PRIVATE_KEY=your_base58_encoded_private_key_here

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# Deployment (automatically set by Vercel)
# VERCEL_URL is set automatically
# VERCEL_ENV is set automatically (development, preview, production)